#!/usr/bin/env bash
#SBATCH --job-name=fp-g0-refine
#SBATCH --partition=gpu
#SBATCH --gres=gpu:1
#SBATCH --array=0-2%3
#SBATCH --cpus-per-task=4
#SBATCH --mem=24G
#SBATCH --time=06:00:00

set -euo pipefail

SUBMIT_DIR="${SLURM_SUBMIT_DIR:-$PWD}"
REPO_ROOT="${FP_REPO_ROOT:-$SUBMIT_DIR}"
STAGE2_DIR="${FP_STAGE2_DIR:-$REPO_ROOT/FP_PINN/pinn/cubic_homogeneous_3d}"

VARIANTS=(exact_lo exact_mid exact_strong)
VARIANT="${VARIANTS[$SLURM_ARRAY_TASK_ID]}"

export FP_CASE_NAME="heat_flux"
export FP_OUTPUT_ROOT="outputs/g0-exact-refine-${SLURM_ARRAY_JOB_ID}/${VARIANT}"
export FP_PACKAGE_TAG="HEAT_FLUX_${VARIANT^^}"
export FP_SEED="${FP_SEED:-20260810}"

export FP_STAGE2_EPOCHS="${FP_STAGE2_EPOCHS:-${FP_REFINE_EPOCHS:-2000}}"
export FP_STAGE2_LR_DECAY_STEPS="${FP_STAGE2_LR_DECAY_STEPS:-1000}"
export FP_STAGE2_LR_DECAY_RATE="${FP_STAGE2_LR_DECAY_RATE:-0.3}"
export FP_GRADIENT_CLIP_NORM="${FP_GRADIENT_CLIP_NORM:-1.0}"
export FP_N_TIME_BATCH="${FP_N_TIME_BATCH:-12}"
export FP_N_VELOCITY_PER_TIME="${FP_N_VELOCITY_PER_TIME:-4096}"
export FP_PDE_WEIGHT="${FP_PDE_WEIGHT:-1.0}"
export FP_HEAT_FLUX_WEIGHT="${FP_HEAT_FLUX_WEIGHT:-2.0}"
export FP_HEAT_FLUX_RATE_WEIGHT="${FP_HEAT_FLUX_RATE_WEIGHT:-10.0}"
export FP_HEAT_FLUX_RATE_STEP="${FP_HEAT_FLUX_RATE_STEP:-0.01}"
export FP_MASS_WEIGHT="${FP_MASS_WEIGHT:-200.0}"
export FP_MOMENTUM_WEIGHT="${FP_MOMENTUM_WEIGHT:-100.0}"
export FP_ENERGY_WEIGHT="${FP_ENERGY_WEIGHT:-200.0}"
export FP_TAIL_FRACTION="${FP_TAIL_FRACTION:-0.20}"
export FP_TAIL_VARIANCE="${FP_TAIL_VARIANCE:-4.0}"
export FP_FIXED_VELOCITY_QUADRATURE="${FP_FIXED_VELOCITY_QUADRATURE:-1}"
export FP_QUADRATURE_PANELS="${FP_QUADRATURE_PANELS:-8}"
export FP_CHECKPOINT_EVERY="${FP_CHECKPOINT_EVERY:-100}"
export FP_CHECKPOINT_SWEEP="${FP_CHECKPOINT_SWEEP:-1}"
export FP_REFERENCE_PARTICLES="${FP_REFERENCE_PARTICLES:-1000000}"
export FP_REFERENCE_DT="${FP_REFERENCE_DT:-0.0025}"
export FP_REFERENCE_SAVE_EVERY="${FP_REFERENCE_SAVE_EVERY:-20}"
export FP_EVALUATION_SAMPLES="${FP_EVALUATION_SAMPLES:-524288}"
export FP_AXISYMMETRIC_HEAT_FLUX="${FP_AXISYMMETRIC_HEAT_FLUX:-1}"
export FP_ANTITHETIC_HEAT_FLUX_QUADRATURE="${FP_ANTITHETIC_HEAT_FLUX_QUADRATURE:-1}"
export FP_STOP_GRADIENT_CLOSURE="${FP_STOP_GRADIENT_CLOSURE:-0}"
export FP_PACKAGE_RESULTS="${FP_PACKAGE_RESULTS:-1}"
export FP_STRICT_GATE="${FP_STRICT_GATE:-1}"

case "$VARIANT" in
    exact_lo)
        export FP_STAGE2_LEARNING_RATE="${FP_STAGE2_LEARNING_RATE:-2.0e-6}"
        export FP_HEAT_FLUX_HISTORY_WEIGHT="${FP_HEAT_FLUX_HISTORY_WEIGHT:-100.0}"
        export FP_RESUME_ANCHOR_WEIGHT="${FP_RESUME_ANCHOR_WEIGHT:-25.0}"
        ;;
    exact_mid)
        export FP_STAGE2_LEARNING_RATE="${FP_STAGE2_LEARNING_RATE:-1.0e-6}"
        export FP_HEAT_FLUX_HISTORY_WEIGHT="${FP_HEAT_FLUX_HISTORY_WEIGHT:-250.0}"
        export FP_RESUME_ANCHOR_WEIGHT="${FP_RESUME_ANCHOR_WEIGHT:-100.0}"
        ;;
    exact_strong)
        export FP_STAGE2_LEARNING_RATE="${FP_STAGE2_LEARNING_RATE:-5.0e-7}"
        export FP_HEAT_FLUX_HISTORY_WEIGHT="${FP_HEAT_FLUX_HISTORY_WEIGHT:-500.0}"
        export FP_RESUME_ANCHOR_WEIGHT="${FP_RESUME_ANCHOR_WEIGHT:-400.0}"
        ;;
    *)
        echo "ERROR: unknown refinement variant: $VARIANT" >&2
        exit 2
        ;;
esac

echo "Exact-history refinement variant: $VARIANT"
echo "Resume archive: ${FP_RESUME_ARCHIVE:-<not set>}"
echo "Seed: $FP_SEED"
echo "Epochs / checkpoint interval: $FP_STAGE2_EPOCHS / $FP_CHECKPOINT_EVERY"
echo "Learning rate / clip: $FP_STAGE2_LEARNING_RATE / $FP_GRADIENT_CLIP_NORM"
echo "Exact-history / resume-anchor weights: $FP_HEAT_FLUX_HISTORY_WEIGHT / $FP_RESUME_ANCHOR_WEIGHT"
echo "Invariant weights (mass/momentum/energy): $FP_MASS_WEIGHT / $FP_MOMENTUM_WEIGHT / $FP_ENERGY_WEIGHT"

exec bash "$STAGE2_DIR/slurm/run_stage2_array.sbatch"
