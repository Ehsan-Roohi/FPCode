@@ -0,0 +1,276 @@
+"""
+    fp_collision35.jl — provisional CPU cubic Fokker--Planck source for M4/35.
+
+This is a bounded research prototype.  The evolved state remains Riemann35's
+35 raw moments through total degree four.  The projected cubic FP source needs
+algebraic tail moments through degree six:
+
+  * M0--M4 are read exactly from the retained state;
+  * M5 is supplied by Riemann35's analytical `Moments5_3D` closure;
+  * M6 is provisionally evaluated from `chyqmom_nodes_3d`.
+
+M6 is NOT an evolved variable and this file does not change the transport
+closure or flux Jacobian.  The CHyQMOM M6 model is deliberately isolated so it
+can be replaced after closure guidance/validation.  This first implementation
+is CPU-only because `chyqmom_nodes_3d` allocates and is not device compatible.
+
+The source is the unclipped continuous-time polynomial counterpart of FPCode's
+particle update.  It does not reproduce the particle-only `m2_lim` cutoff or
+the finite-step alpha rescaling; those effects belong in the particle-reference
+comparison and in the eventual source-integrator study.
+"""
+
+# Total-degree-five ordering returned by Moments5_3D.
+const _FP5_IJK = (
+    (5,0,0),(4,1,0),(3,2,0),(2,3,0),(1,4,0),
+    (4,0,1),(3,0,2),(2,0,3),(1,0,4),
+    (3,1,1),(2,2,1),(1,3,1),(2,1,2),(1,1,3),(1,2,2),
+    (0,5,0),(0,4,1),(0,3,2),(0,2,3),(0,1,4),(0,0,5),
+)
+const _FP5_INDEX = Dict{NTuple{3,Int},Int}(a => n for (n, a) in enumerate(_FP5_IJK))
+
+# All 28 total-degree-six monomials.  The ordering is internal only.
+const _FP6_IJK = Tuple(
+    (i, j, 6-i-j) for i in 6:-1:0 for j in (6-i):-1:0
+)
+const _FP6_INDEX = Dict{NTuple{3,Int},Int}(a => n for (n, a) in enumerate(_FP6_IJK))
+
+@inline _fp_add(a::NTuple{3,Int}, b::NTuple{3,Int}) =
+    (a[1] + b[1], a[2] + b[2], a[3] + b[3])
+
+@inline function _fp_shift(a::NTuple{3,Int}, d::Int, amount::Int)
+    d == 1 && return (a[1] + amount, a[2], a[3])
+    d == 2 && return (a[1], a[2] + amount, a[3])
+    return (a[1], a[2], a[3] + amount)
+end
+
+function _fp_m6_chyqmom(M::AbstractVector)
+    weights, nodes = chyqmom_nodes_3d(M)
+    M6 = zeros(Float64, length(_FP6_IJK))
+    @inbounds for (n, (i, j, k)) in enumerate(_FP6_IJK)
+        value = 0.0
+        for q in eachindex(weights)
+            value += weights[q] * nodes[q,1]^i * nodes[q,2]^j * nodes[q,3]^k
+        end
+        M6[n] = value
+    end
+    return M6
+end
+
+@inline function _fp_tail_value(
+    a::NTuple{3,Int}, M::AbstractVector, M5::AbstractVector, M6::AbstractVector,
+)
+    degree = sum(a)
+    degree <= 4 && return Float64(M[IJK_INDEX[a]])
+    degree == 5 && return Float64(M5[_FP5_INDEX[a]])
+    degree == 6 && return Float64(M6[_FP6_INDEX[a]])
+    throw(ArgumentError("cubic FP projection requested unsupported degree $degree moment $a"))
+end
+
+function _fp_central_retained(M::AbstractVector, a::NTuple{3,Int}, u::NTuple{3,Float64})
+    total = 0.0
+    @inbounds for i in 0:a[1], j in 0:a[2], k in 0:a[3]
+        raw = (i, j, k)
+        coefficient = binomial(a[1], i) * binomial(a[2], j) * binomial(a[3], k) *
+                      (-u[1])^(a[1]-i) * (-u[2])^(a[2]-j) * (-u[3])^(a[3]-k)
+        total += coefficient * M[IJK_INDEX[raw]]
+    end
+    return Float64(total)
+end
+
+function _fp_raw_times_central(
+    raw::NTuple{3,Int}, central::NTuple{3,Int}, u::NTuple{3,Float64}, lookup,
+)
+    total = 0.0
+    @inbounds for i in 0:central[1], j in 0:central[2], k in 0:central[3]
+        expanded = (i, j, k)
+        coefficient = binomial(central[1], i) * binomial(central[2], j) *
+                      binomial(central[3], k) *
+                      (-u[1])^(central[1]-i) * (-u[2])^(central[2]-j) *
+                      (-u[3])^(central[3]-k)
+        total += coefficient * lookup(_fp_add(raw, expanded))
+    end
+    return Float64(total)
+end
+
+"""
+    fp_macroscopic35(M)
+
+Return the density, velocity, temperature, pressure, FPCode-sign stress, and
+heat flux extracted from a Riemann35 raw-moment state.  Units are nondimensional
+with molecular mass and Boltzmann's constant equal to one.
+"""
+function fp_macroscopic35(M::AbstractVector)
+    length(M) == 35 || throw(ArgumentError("fp_macroscopic35 expects 35 moments"))
+    rho = Float64(M[1])
+    rho > 0.0 || throw(ArgumentError("M000 must be positive"))
+    u = (Float64(M[2]/rho), Float64(M[6]/rho), Float64(M[16]/rho))
+
+    C200 = _fp_central_retained(M, (2,0,0), u)
+    C020 = _fp_central_retained(M, (0,2,0), u)
+    C002 = _fp_central_retained(M, (0,0,2), u)
+    C110 = _fp_central_retained(M, (1,1,0), u)
+    C101 = _fp_central_retained(M, (1,0,1), u)
+    C011 = _fp_central_retained(M, (0,1,1), u)
+    theta = (C200 + C020 + C002) / (3.0*rho)
+    theta > 0.0 || throw(ArgumentError("FP temperature theta must be positive"))
+    pressure = rho*theta
+
+    stress = zeros(Float64, 3, 3)
+    stress[1,1] = -(C200-pressure)
+    stress[2,2] = -(C020-pressure)
+    stress[3,3] = -(C002-pressure)
+    stress[1,2] = stress[2,1] = -C110
+    stress[1,3] = stress[3,1] = -C101
+    stress[2,3] = stress[3,2] = -C011
+
+    C300 = _fp_central_retained(M, (3,0,0), u)
+    C120 = _fp_central_retained(M, (1,2,0), u)
+    C102 = _fp_central_retained(M, (1,0,2), u)
+    C210 = _fp_central_retained(M, (2,1,0), u)
+    C030 = _fp_central_retained(M, (0,3,0), u)
+    C012 = _fp_central_retained(M, (0,1,2), u)
+    C201 = _fp_central_retained(M, (2,0,1), u)
+    C021 = _fp_central_retained(M, (0,2,1), u)
+    C003 = _fp_central_retained(M, (0,0,3), u)
+    heat_flux = 0.5 .* [C300 + C120 + C102,
+                         C210 + C030 + C012,
+                         C201 + C021 + C003]
+
+    return (rho=rho, velocity=u, theta=theta, pressure=pressure,
+            stress=stress, heat_flux=heat_flux)
+end
+
+"""
+    fp_collision_source35(M, tau; Pr=2/3, gamma_scale=0.05)
+
+Project FPCode's continuous cubic Fokker--Planck generator onto Riemann35's
+retained M0--M4 state.  `tau` is the collision relaxation time; it is explicit
+here so a later solver integration can map Riemann35's `Kn` convention in one
+well-tested location.
+
+The source is projected onto the exact collision-invariant subspace: mass and
+all three momenta are zero, and the trace of the second-moment source is zero.
+"""
+function fp_collision_source35(
+    M::AbstractVector, tau::Real; Pr::Real=2/3, gamma_scale::Real=0.05,
+)
+    length(M) == 35 || throw(ArgumentError("fp_collision_source35 expects 35 moments"))
+    tau > 0.0 || throw(ArgumentError("tau must be positive"))
+    0.0 < Pr <= 1.0 || throw(ArgumentError("Pr must lie in (0,1]"))
+    all(isfinite, M) || throw(ArgumentError("moment state contains NaN or Inf"))
+
+    state = fp_macroscopic35(M)
+    rho = state.rho; u = state.velocity; theta = state.theta
+    invtau = 1.0/Float64(tau)
+    prfactor = (1.0-Float64(Pr))/Float64(Pr)
+    C = invtau .* state.stress ./ state.pressure
+    beta = invtau * prfactor / (10.0*theta^2)
+    qscale = rho*theta*sqrt(theta)
+    gamma = Float64(gamma_scale) * invtau * prfactor .* state.heat_flux ./
+            (qscale*theta)
+    diffusion = theta*invtau
+
+    M5, _, _ = Moments5_3D(M)
+    M6 = _fp_m6_chyqmom(M)
+    lookup(a) = _fp_tail_value(a, M, M5, M6)
+
+    source = zeros(Float64, 35)
+    @inbounds for (position, alpha) in enumerate(IJK)
+        value = 0.0
+        for direction in 1:3
+            exponent = alpha[direction]
+            exponent == 0 && continue
+            raw = _fp_shift(alpha, direction, -1)
+
+            cdir = ntuple(d -> d == direction ? 1 : 0, 3)
+            drift = -invtau * _fp_raw_times_central(raw, cdir, u, lookup)
+
+            for coupled in 1:3
+                clin = ntuple(d -> d == coupled ? 1 : 0, 3)
+                drift += C[direction,coupled] *
+                         _fp_raw_times_central(raw, clin, u, lookup)
+            end
+
+            if gamma[direction] != 0.0
+                quadratic = 0.0
+                for squared in 1:3
+                    c2 = ntuple(d -> d == squared ? 2 : 0, 3)
+                    quadratic += _fp_raw_times_central(raw, c2, u, lookup)
+                end
+                drift += gamma[direction] * (quadratic - 5.0*theta*lookup(raw))
+            end
+
+            if beta != 0.0
+                cubic = 0.0
+                for squared in 1:3
+                    c3 = ntuple(d -> (d == squared ? 2 : 0) +
+                                      (d == direction ? 1 : 0), 3)
+                    cubic += _fp_raw_times_central(raw, c3, u, lookup)
+                end
+                drift += beta * (cubic - 2.0*state.heat_flux[direction]/rho*lookup(raw))
+            end
+            value += exponent*drift
+
+            if exponent >= 2
+                lower = _fp_shift(alpha, direction, -2)
+                value += diffusion*exponent*(exponent-1)*lookup(lower)
+            end
+        end
+        source[position] = value
+    end
+
+    # Exact collision-invariant projection, matching the conservation contract
+    # used by the homogeneous FPCode validation reference.
+    source[IJK_INDEX[(0,0,0)]] = 0.0
+    source[IJK_INDEX[(1,0,0)]] = 0.0
+    source[IJK_INDEX[(0,1,0)]] = 0.0
+    source[IJK_INDEX[(0,0,1)]] = 0.0
+    eidx = (IJK_INDEX[(2,0,0)], IJK_INDEX[(0,2,0)], IJK_INDEX[(0,0,2)])
+    eleak = source[eidx[1]] + source[eidx[2]] + source[eidx[3]]
+    for n in eidx
+        source[n] -= eleak/3.0
+    end
+    return source
+end
+
+"""
+    fp_collision35(M, dt, tau; Pr=2/3, gamma_scale=0.05,
+                   lam_min=0, max_substeps=256)
+
+Advance the provisional nonlinear FP source with explicit Euler substeps.  If
+a trial leaves the retained M4 realizability cone, the step is retried with
+twice as many substeps.  This is a validation integrator, not the final
+production time discretization.
+"""
+function fp_collision35(
+    M::AbstractVector, dt::Real, tau::Real;
+    Pr::Real=2/3, gamma_scale::Real=0.05,
+    lam_min::Real=0.0, max_substeps::Int=256,
+)
+    dt >= 0.0 || throw(ArgumentError("dt must be non-negative"))
+    dt == 0.0 && return Float64.(M)
+    max_substeps >= 1 || throw(ArgumentError("max_substeps must be positive"))
+
+    nsub = 1
+    while nsub <= max_substeps
+        trial = Float64.(M)
+        h = Float64(dt)/nsub
+        accepted = true
+        for _ in 1:nsub
+            candidate = trial .+ h .* fp_collision_source35(
+                trial, tau; Pr=Pr, gamma_scale=gamma_scale,
+            )
+            if !is_realizable(candidate; lam_min=lam_min)
+                accepted = false
+                break
+            end
+            trial = candidate
+        end
+        accepted && return trial
+        nsub *= 2
+    end
+    throw(ErrorException(
+        "provisional FP collision step left the realizability cone after $max_substeps substeps",
+    ))
+end
