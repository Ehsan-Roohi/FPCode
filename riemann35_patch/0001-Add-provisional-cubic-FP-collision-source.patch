+using Test
+using Riemann35
+using LinearAlgebra
+
+function fp_test_mixture()
+    M1 = InitializeM4_35(
+        0.55, -0.35, 0.08, 0.02,
+        0.72, 0.04, 0.01, 0.48, -0.02, 0.39,
+    )
+    M2 = InitializeM4_35(
+        0.45, 0.55, -0.04, -0.01,
+        0.44, -0.03, 0.02, 0.58, 0.01, 0.36,
+    )
+    return M1 .+ M2
+end
+
+@testset "provisional cubic FP collision source" begin
+    @testset "macroscopic convention" begin
+        rho = 1.7
+        u = (0.3, -0.2, 0.1)
+        theta = 0.8
+        M = InitializeM4_35(
+            rho, u[1], u[2], u[3], theta, 0.0, 0.0, theta, 0.0, theta,
+        )
+        state = fp_macroscopic35(M)
+        @test state.rho ≈ rho atol=1e-14
+        @test collect(state.velocity) ≈ collect(u) atol=1e-14
+        @test state.theta ≈ theta atol=2e-14
+        @test norm(state.stress) <= 2e-13
+        @test norm(state.heat_flux) <= 2e-13
+
+        mixture_state = fp_macroscopic35(fp_test_mixture())
+        @test collect(mixture_state.velocity) ≈ [0.055, 0.026, 0.0065] atol=2e-14
+        @test mixture_state.theta ≈ 0.56658725 atol=2e-14
+        @test mixture_state.stress ≈ [
+            -0.22788775  0.01823   -0.0078175;
+             0.01823     0.03802325 0.005609;
+            -0.0078175   0.005609   0.1898645
+        ] atol=2e-13
+        @test mixture_state.heat_flux ≈ [
+            -0.07456222125, -0.0168923205, 0.002032482375,
+        ] atol=2e-13
+    end
+
+    @testset "OU limit keeps a Maxwellian stationary" begin
+        M = InitializeM4_35(
+            1.7, 0.3, -0.2, 0.1,
+            0.8, 0.0, 0.0, 0.8, 0.0, 0.8,
+        )
+        source = fp_collision_source35(M, 0.6; Pr=1.0)
+        @test maximum(abs.(source)) <= 5e-12
+    end
+
+    @testset "M5/M6 tail is finite and algebraic" begin
+        M = fp_test_mixture()
+        M5, _, _ = Moments5_3D(M)
+        M6 = Riemann35._fp_m6_chyqmom(M)
+        @test length(M5) == 21
+        @test length(M6) == 28
+        @test all(isfinite, M5)
+        @test all(isfinite, M6)
+        @test length(M) == 35  # no M5/M6 state variables are introduced
+    end
+
+    @testset "full cubic source conserves collision invariants" begin
+        M = fp_test_mixture()
+        source = fp_collision_source35(M, 0.9; Pr=2/3)
+        @test all(isfinite, source)
+        @test source[IJK_INDEX[(0,0,0)]] == 0.0
+        @test source[IJK_INDEX[(1,0,0)]] == 0.0
+        @test source[IJK_INDEX[(0,1,0)]] == 0.0
+        @test source[IJK_INDEX[(0,0,1)]] == 0.0
+        energy_source = source[IJK_INDEX[(2,0,0)]] +
+                        source[IJK_INDEX[(0,2,0)]] +
+                        source[IJK_INDEX[(0,0,2)]]
+        @test abs(energy_source) <= 5e-13
+    end
+
+    @testset "small validation step stays realizable and conservative" begin
+        M = fp_test_mixture()
+        @test is_realizable(M)
+        updated = fp_collision35(M, 1e-5, 0.9; Pr=2/3)
+        @test is_realizable(updated)
+        @test updated[1] == M[1]
+        @test updated[2] == M[2]
+        @test updated[6] == M[6]
+        @test updated[16] == M[16]
+        energy(Mv) = Mv[IJK_INDEX[(2,0,0)]] + Mv[IJK_INDEX[(0,2,0)]] +
+                     Mv[IJK_INDEX[(0,0,2)]]
+        @test energy(updated) ≈ energy(M) atol=5e-13 rtol=0
+    end
+end
