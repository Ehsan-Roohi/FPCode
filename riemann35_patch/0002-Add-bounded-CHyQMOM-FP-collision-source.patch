+    @testset "bounded quadrature source matches FPCode stabilization" begin
+        M = fp_test_mixture()
+        source = fp_collision_source35_bounded(M, 0.9; Pr=2/3)
+        @test all(isfinite, source)
+        @test source[IJK_INDEX[(0,0,0)]] == 0.0
+        @test source[IJK_INDEX[(1,0,0)]] == 0.0
+        @test source[IJK_INDEX[(0,1,0)]] == 0.0
+        @test source[IJK_INDEX[(0,0,1)]] == 0.0
+        energy_source = source[IJK_INDEX[(2,0,0)]] +
+                        source[IJK_INDEX[(0,2,0)]] +
+                        source[IJK_INDEX[(0,0,2)]]
+        @test abs(energy_source) <= 5e-13
+
+        maxwellian = InitializeM4_35(
+            1.7, 0.3, -0.2, 0.1,
+            0.8, 0.0, 0.0, 0.8, 0.0, 0.8,
+        )
+        equilibrium_source = fp_collision_source35_bounded(
+            maxwellian, 0.6; Pr=1.0,
+        )
+        @test maximum(abs.(equilibrium_source)) <= 5e-12
+
+        # A small remote population activates the m2 limiter on the CHyQMOM
+        # nodes, so the bounded and effectively-unclipped sources must differ.
+        tail = InitializeM4_35(
+            0.98, 0.0, 0.0, 0.0,
+            0.2, 0.0, 0.0, 0.2, 0.0, 0.2,
+        ) .+ InitializeM4_35(
+            0.02, 8.0, 0.0, 0.0,
+            0.2, 0.0, 0.0, 0.2, 0.0, 0.2,
+        )
+        limited = fp_collision_source35_bounded(tail, 0.9; speed_cap=25.0)
+        effectively_unlimited = fp_collision_source35_bounded(
+            tail, 0.9; speed_cap=1.0e8,
+        )
+        @test norm(limited - effectively_unlimited) > 1e-8
+    end
+
     @testset "small validation step stays realizable and conservative" begin
         M = fp_test_mixture()
         @test is_realizable(M)
