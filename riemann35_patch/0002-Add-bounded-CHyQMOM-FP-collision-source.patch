+"""
+    fp_collision_source35_bounded(M, tau; Pr=2/3, gamma_scale=0.05,
+                                  speed_cap=25)
+
+Evaluate the cubic FP collision source on the CHyQMOM quadrature represented by
+the retained 35 moments.  Unlike [`fp_collision_source35`](@ref), this path
+matches the stabilizing pieces of FPCode's particle update:
+
+  * `|c|^2` in the gamma and beta terms is limited to `speed_cap*theta`;
+  * the mean nonlinear drift is removed, the continuous counterpart of the
+    homogeneous reference's exact momentum recentering; and
+  * `-lambda*c`, with `lambda = <c dot N>/(3theta)`, is included as the
+    continuous-time limit of FPCode's finite-step alpha energy rescaling.
+
+The capped terms are non-polynomial, so they cannot be assembled exactly from a
+finite list of M5/M6 raw moments.  Direct CHyQMOM evaluation retains the cutoff
+without adding evolved variables.  The implementation is CPU-only and intended
+for homogeneous source validation before a device-side design is selected.
+"""
+function fp_collision_source35_bounded(
+    M::AbstractVector, tau::Real;
+    Pr::Real=2/3, gamma_scale::Real=0.05, speed_cap::Real=25.0,
+)
+    length(M) == 35 || throw(ArgumentError(
+        "fp_collision_source35_bounded expects 35 moments",
+    ))
+    tau > 0.0 || throw(ArgumentError("tau must be positive"))
+    0.0 < Pr <= 1.0 || throw(ArgumentError("Pr must lie in (0,1]"))
+    speed_cap > 0.0 || throw(ArgumentError("speed_cap must be positive"))
+    all(isfinite, M) || throw(ArgumentError("moment state contains NaN or Inf"))
+
+    state = fp_macroscopic35(M)
+    rho = state.rho; u = state.velocity; theta = state.theta
+    invtau = 1.0/Float64(tau)
+    prfactor = (1.0-Float64(Pr))/Float64(Pr)
+    C = invtau .* state.stress ./ state.pressure
+    beta = invtau * prfactor / (10.0*theta^2)
+    qscale = rho*theta*sqrt(theta)
+    gamma = Float64(gamma_scale) * invtau * prfactor .* state.heat_flux ./
+            (qscale*theta)
+    diffusion = theta*invtau
+
+    weights, nodes = chyqmom_nodes_3d(M)
+    node_count = length(weights)
+    nonlinear = zeros(Float64, node_count, 3)
+    peculiar = zeros(Float64, node_count, 3)
+    mean_nonlinear = zeros(Float64, 3)
+    mean_cn = 0.0
+    cap = Float64(speed_cap)*theta
+
+    @inbounds for q in eachindex(weights)
+        cx = nodes[q,1] - u[1]
+        cy = nodes[q,2] - u[2]
+        cz = nodes[q,3] - u[3]
+        peculiar[q,1] = cx; peculiar[q,2] = cy; peculiar[q,3] = cz
+        c2_used = min(cx*cx + cy*cy + cz*cz, cap)
+        for direction in 1:3
+            nd = C[direction,1]*cx + C[direction,2]*cy + C[direction,3]*cz
+            nd += gamma[direction]*(c2_used - 5.0*theta)
+            nd += beta*(c2_used*peculiar[q,direction] -
+                        2.0*state.heat_flux[direction]/rho)
+            nonlinear[q,direction] = nd
+            mean_nonlinear[direction] += weights[q]*nd
+            mean_cn += weights[q]*peculiar[q,direction]*nd
+        end
     end
-    return source
+    mean_nonlinear ./= rho
+    lambda = mean_cn/(3.0*rho*theta)
+
+    source = zeros(Float64, 35)
+    @inbounds for (position, alpha) in enumerate(IJK)
+        value = 0.0
+        for direction in 1:3
+            exponent = alpha[direction]
+            exponent == 0 && continue
+            raw = _fp_shift(alpha, direction, -1)
+            drift_moment = 0.0
+            for q in eachindex(weights)
+                drift = -invtau*peculiar[q,direction] +
+                        nonlinear[q,direction] - mean_nonlinear[direction] -
+                        lambda*peculiar[q,direction]
+                monomial = nodes[q,1]^raw[1] * nodes[q,2]^raw[2] * nodes[q,3]^raw[3]
+                drift_moment += weights[q]*monomial*drift
+            end
+            value += exponent*drift_moment
+
+            if exponent >= 2
+                lower = _fp_shift(alpha, direction, -2)
+                value += diffusion*exponent*(exponent-1)*M[IJK_INDEX[lower]]
+            end
+        end
+        source[position] = value
+    end
+
+    # The velocity-space mean and alpha corrections already conserve momentum
+    # and energy.  Remove only accumulated quadrature/roundoff leakage exactly.
+    return _fp_project_invariants!(source)
 end
 
 """
