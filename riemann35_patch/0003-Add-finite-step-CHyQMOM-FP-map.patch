+    @testset "bounded finite-step map matches particle algorithm structure" begin
+        M = fp_test_mixture()
+        updated, diagnostics = fp_collision_step35_bounded(
+            M, 2.5e-4, 0.9; Pr=2/3, with_diagnostics=true,
+        )
+        @test all(isfinite, updated)
+        @test is_realizable(updated)
+        @test diagnostics.alpha > 0.0
+        @test diagnostics.alpha_squared > 0.0
+        @test diagnostics.affine_scale > 0.0
+        @test diagnostics.maximum_c2_over_theta > 0.0
+        @test updated[IJK_INDEX[(0,0,0)]] == M[IJK_INDEX[(0,0,0)]]
+        @test updated[IJK_INDEX[(1,0,0)]] == M[IJK_INDEX[(1,0,0)]]
+        @test updated[IJK_INDEX[(0,1,0)]] == M[IJK_INDEX[(0,1,0)]]
+        @test updated[IJK_INDEX[(0,0,1)]] == M[IJK_INDEX[(0,0,1)]]
+        energy(Mv) = Mv[IJK_INDEX[(2,0,0)]] + Mv[IJK_INDEX[(0,2,0)]] +
+                     Mv[IJK_INDEX[(0,0,2)]]
+        @test energy(updated) ≈ energy(M) atol=5e-13 rtol=0
+
+        maxwellian = InitializeM4_35(
+            1.7, 0.3, -0.2, 0.1,
+            0.8, 0.0, 0.0, 0.8, 0.0, 0.8,
+        )
+        equilibrium = fp_collision_step35_bounded(
+            maxwellian, 2.5e-4, 0.6; Pr=1.0,
+        )
+        @test maximum(abs.(equilibrium - maxwellian)) <= 2e-11
+    end
+
     @testset "small validation step stays realizable and conservative" begin
         M = fp_test_mixture()
         @test is_realizable(M)
