     return _fp_project_invariants!(source)
 end
 
+function _fp_affine_isotropic35(
+    M::AbstractVector, scale::Float64, shift::NTuple{3,Float64},
+)
+    transformed = zeros(Float64, 35)
+    @inbounds for (position, alpha) in enumerate(IJK)
+        value = 0.0
+        for i in 0:alpha[1], j in 0:alpha[2], k in 0:alpha[3]
+            raw = (i, j, k)
+            coefficient = binomial(alpha[1], i) * binomial(alpha[2], j) *
+                          binomial(alpha[3], k) * scale^(i+j+k) *
+                          shift[1]^(alpha[1]-i) * shift[2]^(alpha[2]-j) *
+                          shift[3]^(alpha[3]-k)
+            value += coefficient*M[IJK_INDEX[raw]]
+        end
+        transformed[position] = value
+    end
+    return transformed
+end
+
+"""
+    fp_collision_step35_bounded(M, dt, tau; Pr=2/3, gamma_scale=0.05,
+                                speed_cap=25, with_diagnostics=false)
+
+Advance one homogeneous collision interval with the same finite-step structure
+as FPCode's particle kernel.  The CHyQMOM nodes receive the exact OU factor,
+the capped nonlinear drift, FPCode's full finite-step `alpha`, and Gaussian
+noise variance.  Moments through degree four are then evaluated analytically
+from the resulting Gaussian mixture.
+
+This map avoids applying explicit Euler to the very stiff continuous bounded
+source.  An isotropic affine correction matches the incoming density, velocity,
+and thermal energy exactly, mirroring the recenter/rescale used by the
+homogeneous particle validator.  It is a CPU validation map, not a production
+spatial collision kernel.
+"""
+function fp_collision_step35_bounded(
+    M::AbstractVector, dt::Real, tau::Real;
+    Pr::Real=2/3, gamma_scale::Real=0.05, speed_cap::Real=25.0,
+    with_diagnostics::Bool=false,
+)
+    length(M) == 35 || throw(ArgumentError(
+        "fp_collision_step35_bounded expects 35 moments",
+    ))
+    dt >= 0.0 || throw(ArgumentError("dt must be non-negative"))
+    tau > 0.0 || throw(ArgumentError("tau must be positive"))
+    0.0 < Pr <= 1.0 || throw(ArgumentError("Pr must lie in (0,1]"))
+    speed_cap > 0.0 || throw(ArgumentError("speed_cap must be positive"))
+    all(isfinite, M) || throw(ArgumentError("moment state contains NaN or Inf"))
+    if dt == 0.0
+        result = Float64.(M)
+        diagnostics = (
+            alpha=1.0, alpha_squared=1.0, affine_scale=1.0,
+            mean_n2=0.0, mean_cn=0.0, maximum_c2_over_theta=0.0,
+        )
+        return with_diagnostics ? (result, diagnostics) : result
+    end
+
+    state = fp_macroscopic35(M)
+    rho = state.rho; u = state.velocity; theta = state.theta
+    invtau = 1.0/Float64(tau)
+    prfactor = (1.0-Float64(Pr))/Float64(Pr)
+    C = invtau .* state.stress ./ state.pressure
+    beta = invtau * prfactor / (10.0*theta^2)
+    qscale = rho*theta*sqrt(theta)
+    gamma = Float64(gamma_scale) * invtau * prfactor .* state.heat_flux ./
+            (qscale*theta)
+
+    weights, nodes = chyqmom_nodes_3d(M)
+    quadrature_mass = sum(weights)
+    quadrature_mass > 0.0 || error("CHyQMOM quadrature has nonpositive mass")
+    weight_scale = rho/quadrature_mass
+    node_count = length(weights)
+    peculiar = zeros(Float64, node_count, 3)
+    nonlinear = zeros(Float64, node_count, 3)
+    mean_n2 = 0.0
+    mean_cn = 0.0
+    maximum_c2 = 0.0
+    cap = Float64(speed_cap)*theta
+
+    @inbounds for q in eachindex(weights)
+        cx = nodes[q,1] - u[1]
+        cy = nodes[q,2] - u[2]
+        cz = nodes[q,3] - u[3]
+        peculiar[q,1] = cx; peculiar[q,2] = cy; peculiar[q,3] = cz
+        c2 = cx*cx + cy*cy + cz*cz
+        maximum_c2 = max(maximum_c2, c2)
+        c2_used = min(c2, cap)
+        n2 = 0.0
+        cn = 0.0
+        for direction in 1:3
+            nd = C[direction,1]*cx + C[direction,2]*cy + C[direction,3]*cz
+            nd += gamma[direction]*(c2_used - 5.0*theta)
+            nd += beta*(c2_used*peculiar[q,direction] -
+                        2.0*state.heat_flux[direction]/rho)
+            nonlinear[q,direction] = nd
+            n2 += nd*nd
+            cn += peculiar[q,direction]*nd
+        end
+        probability_weight = weight_scale*weights[q]/rho
+        mean_n2 += probability_weight*n2
+        mean_cn += probability_weight*cn
+    end
+
+    step = Float64(dt)
+    relaxation = exp(-step/Float64(tau))
+    relaxation2 = relaxation*relaxation
+    alpha_squared = 1.0 + Float64(tau)/(3.0*theta) * (
+        Float64(tau)*(1.0-relaxation)^2*mean_n2 +
+        2.0*(relaxation-relaxation2)*mean_cn
+    )
+    alpha = alpha_squared > 1.0e-6 ? sqrt(alpha_squared) : 1.0
+    noise_variance = theta*(1.0-relaxation2)/(alpha*alpha)
+    noise_variance >= 0.0 || error("finite FP map produced negative noise variance")
+
+    updated = zeros(Float64, 35)
+    @inbounds for q in eachindex(weights)
+        node_weight = weight_scale*weights[q]
+        node_weight == 0.0 && continue
+        mean_velocity = ntuple(direction ->
+            u[direction] + (
+                relaxation*peculiar[q,direction] +
+                (1.0-relaxation)*Float64(tau)*nonlinear[q,direction]
+            )/alpha,
+            3,
+        )
+        updated .+= InitializeM4_35(
+            node_weight,
+            mean_velocity[1], mean_velocity[2], mean_velocity[3],
+            noise_variance, 0.0, 0.0,
+            noise_variance, 0.0, noise_variance,
+        )
+    end
+
+    mapped_state = fp_macroscopic35(updated)
+    affine_scale = sqrt(theta/mapped_state.theta)
+    affine_shift = ntuple(
+        direction -> Float64(u[direction] - affine_scale*mapped_state.velocity[direction]),
+        3,
+    )
+    corrected = _fp_affine_isotropic35(updated, affine_scale, affine_shift)
+
+    # Pin collision invariants after the affine map; these assignments remove
+    # only floating-point roundoff from an already conservative transformation.
+    corrected[IJK_INDEX[(0,0,0)]] = M[IJK_INDEX[(0,0,0)]]
+    corrected[IJK_INDEX[(1,0,0)]] = M[IJK_INDEX[(1,0,0)]]
+    corrected[IJK_INDEX[(0,1,0)]] = M[IJK_INDEX[(0,1,0)]]
+    corrected[IJK_INDEX[(0,0,1)]] = M[IJK_INDEX[(0,0,1)]]
+    energy_indices = (
+        IJK_INDEX[(2,0,0)], IJK_INDEX[(0,2,0)], IJK_INDEX[(0,0,2)],
+    )
+    energy_error = sum(M[n] for n in energy_indices) -
+                   sum(corrected[n] for n in energy_indices)
+    for n in energy_indices
+        corrected[n] += energy_error/3.0
+    end
+    all(isfinite, corrected) || error("finite FP map produced NaN or Inf")
+
+    diagnostics = (
+        alpha=alpha,
+        alpha_squared=alpha_squared,
+        affine_scale=affine_scale,
+        mean_n2=mean_n2,
+        mean_cn=mean_cn,
+        maximum_c2_over_theta=maximum_c2/theta,
+    )
+    return with_diagnostics ? (corrected, diagnostics) : corrected
+end
+
 """
     fp_collision35(M, dt, tau; Pr=2/3, gamma_scale=0.05,
                    lam_min=0, max_substeps=256)
